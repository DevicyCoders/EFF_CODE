{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "JScript9",
  "scopeName": "source.jscript9",
  "fileTypes": ["js"],
  "patterns": [
    {
      "include": "#import-block"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#jsdoc"
    }
  ],
  "repository": {
    "import-block": {
      "patterns": [
        {
          "name": "comment.block.jscript9.import",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#import-statement"
            }
          ]
        }
      ]
    },
    "import-statement": {
      "patterns": [
        {
          "name": "meta.import.jscript9",
          "match": "(@import)\\s+(?:(\\w+)\\s+(from)\\s+)?[\"']([^\"']+)[\"']",
          "captures": {
            "1": {
              "name": "keyword.control.import.jscript9"
            },
            "2": {
              "name": "variable.other.module.jscript9"
            },
            "3": {
              "name": "keyword.control.from.jscript9"
            },
            "4": {
              "name": "string.quoted.module.path.jscript9"
            }
          }
        },
        {
          "name": "meta.import.ecma.jscript9",
          "match": "(@import)\\s+[\"'](ecma)[\"']",
          "captures": {
            "1": {
              "name": "keyword.control.import.jscript9"
            },
            "2": {
              "name": "support.type.builtin.ecma.jscript9"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.jscript9",
          "match": "\\b(break|case|catch|continue|default|do|else|finally|for|function|if|in|new|return|switch|this|throw|try|typeof|var|while|with)\\b"
        },
        {
          "name": "keyword.operator.jscript9",
          "match": "\\b(delete|instanceof|void)\\b"
        },
        {
          "name": "storage.type.jscript9",
          "match": "\\b(var)\\b"
        },
        {
          "name": "keyword.other.jscript9",
          "match": "\\b(debugger)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.jscript9",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.jscript9",
          "match": "\\b(null)\\b"
        },
        {
          "name": "constant.language.undefined.jscript9",
          "match": "\\b(undefined)\\b"
        },
        {
          "name": "constant.language.nan.jscript9",
          "match": "\\b(NaN)\\b"
        },
        {
          "name": "constant.language.infinity.jscript9",
          "match": "\\b(Infinity)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.jscript9",
          "match": "(function)\\s+([a-zA-Z_$][a-zA-Z0-9_$]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "keyword.function.jscript9"
            },
            "2": {
              "name": "entity.name.function.jscript9"
            }
          }
        },
        {
          "name": "meta.function.anonymous.jscript9",
          "match": "(function)\\s*\\(",
          "captures": {
            "1": {
              "name": "keyword.function.jscript9"
            }
          }
        },
        {
          "name": "meta.method-call.jscript9",
          "match": "([a-zA-Z_$][a-zA-Z0-9_$]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "entity.name.function.jscript9"
            }
          }
        },
        {
          "name": "meta.method.jscript9",
          "match": "([a-zA-Z_$][a-zA-Z0-9_$]*)\\s*:\\s*function\\s*\\(",
          "captures": {
            "1": {
              "name": "entity.name.function.jscript9"
            }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.language.jscript9",
          "match": "\\b(this|arguments)\\b"
        },
        {
          "name": "variable.other.jscript9",
          "match": "[a-zA-Z_$][a-zA-Z0-9_$]*"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.jscript9",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.jscript9",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.jscript9",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.jscript9",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.jscript9",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.hex.jscript9",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.octal.jscript9",
          "match": "\\b0[0-7]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.jscript9",
          "match": "(=|\\+=|-=|\\*=|/=|%=|<<=|>>=|>>>=|&=|\\|=|\\^=)"
        },
        {
          "name": "keyword.operator.comparison.jscript9",
          "match": "(==|!=|===|!==|<|>|<=|>=)"
        },
        {
          "name": "keyword.operator.arithmetic.jscript9",
          "match": "(\\+|\\-|\\*|/|%|\\+\\+|\\-\\-)"
        },
        {
          "name": "keyword.operator.logical.jscript9",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.jscript9",
          "match": "(&|\\||\\^|~|<<|>>|>>>)"
        },
        {
          "name": "keyword.operator.ternary.jscript9",
          "match": "(\\?|:)"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.jscript9",
          "match": "//.*$"
        },
        {
          "name": "comment.block.jscript9",
          "begin": "/\\*(?!\\*)",
          "end": "\\*/"
        }
      ]
    },
    "jsdoc": {
      "patterns": [
        {
          "name": "comment.block.documentation.jscript9",
          "begin": "/\\*\\*",
          "end": "\\*/",
          "patterns": [
            {
              "name": "storage.type.class.jsdoc",
              "match": "@(param|return|returns|throws|description|deprecated|see|since|override|memberof|namespace|exports|this|constructor|const|typedef|type|implements|function|extends|enum|public|private|protected|readonly|static)\\b"
            },
            {
              "name": "variable.other.jsdoc",
              "match": "@\\w+"
            },
            {
              "name": "entity.name.type.instance.jsdoc",
              "match": "\\{[^}]+\\}"
            }
          ]
        }
      ]
    },
    "builtin-objects": {
      "patterns": [
        {
          "name": "support.class.builtin.jscript9",
          "match": "\\b(Array|Boolean|Date|Error|Function|Math|Number|Object|RegExp|String|JSON)\\b"
        },
        {
          "name": "support.function.builtin.jscript9",
          "match": "\\b(parseInt|parseFloat|isNaN|isFinite|eval|encodeURIComponent|decodeURIComponent|encodeURI|decodeURI)\\b"
        }
      ]
    }
  }
}