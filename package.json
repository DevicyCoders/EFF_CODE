{
  "name": "eff-code",
  "displayName": "EFF_Code",
  "description": "Development tools for Efficy",
  "version": "0.0.2",
  "publisher": "devicycoders",
  "repository": "https://github.com/DevicyCoders/EFF_CODE",
  "engines": {
    "vscode": "^1.72.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "activationEvents": [
    "onCommand:eff-code.helloWorld",
    "onView:eff-code-help"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "eff-code.helloWorld",
        "title": "Hello World"
      }
    ],
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/snippets.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/javascript.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "eff-code-sidebar",
          "title": "Efficy Help",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "eff-code-sidebar": [
        {
          "id": "eff-code-help",
          "name": "Efficy Help",
          "type": "webview"
        }
      ]
    },
    "languages": [
      {
        "id": "efficy-macro",
        "aliases": ["Efficy Macro", "efficy-macro"],
        "filenamePatterns": ["**/efficy/macros/Macro*.txt"]
      },
      {
        "id": "jscript9",
        "aliases": ["JScript9", "jscript9", "Efficy JScript"],
        "extensions": [".js"],
        "filenamePatterns": ["**/efficy/serverjs/**/*.js", "**/customs/**/serverjs/**/*.js"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jscript9",
        "scopeName": "source.jscript9",
        "path": "./syntaxes/jscript9.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "JScript9",
      "properties": {
        "jscript9.customBasePath": {
          "type": "string",
          "default": "/mnt/c/inetpub/wwwroot/12.0/customs/fidal-gh/efficy/serverjs",
          "description": "Base path for resolving custom JScript9 module imports"
        },
        "jscript9.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable JScript9 diagnostics"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "deploy": "vsce publish"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "16.x",
    "@types/vscode": "^1.72.0",
    "@typescript-eslint/eslint-plugin": "^5.38.1",
    "@typescript-eslint/parser": "^5.38.1",
    "@vscode/test-electron": "^2.1.5",
    "eslint": "^8.24.0",
    "glob": "^8.0.3",
    "mocha": "^10.0.0",
    "ts-loader": "^9.4.1",
    "typescript": "^4.8.4",
    "vsce": "^2.13.0",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  }
}
